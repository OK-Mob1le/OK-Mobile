# Токен бота от @BotFather — никогда не публикуйте и не коммитьте в git
BOT_TOKEN=вставьте_сюда_токен_от_botfather

# Username бота без @ (например OK_MobileBOT)
BOT_USERNAME=вставьте_username_бота

# Railway сам подставляет порт — эту строку можно не трогать
PORT=3000

# Случайный секрет для хэширования кодов подтверждения — уже сгенерирован, можно использовать как есть
SERVER_SECRET=cfd098d75e914c78fb9b0357d208a80a73bb9cc1b83c2ca66885b2ef3492d859

# Можно оставить пустым — сайт и API теперь на одном домене
ALLOWED_ORIGINS=

# Файл базы данных сессий. Для теста можно не трогать.
# Если позже подключите Railway Volume — поменяйте на путь внутри него,
# например /data/okmobile.sqlite3
SQLITE_PATH=./okmobile.sqlite3
