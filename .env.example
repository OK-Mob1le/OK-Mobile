# Токен бота от @BotFather — никогда не публикуйте и не коммитьте в git
BOT_TOKEN=вставьте_сюда_токен_от_botfather

# Username бота без @ (например OKMobileVerifyBot)
BOT_USERNAME=вставьте_username_бота

# Публичный URL этого сервиса после деплоя на Railway (для установки вебхука).
# Оставьте пустым при первом деплое — впишите после того, как Railway выдаст домен.
BACKEND_URL=

# Railway сам подставляет порт — эту строку можно не трогать
PORT=3000

# Случайный секрет для хэширования кодов подтверждения — уже сгенерирован, можно использовать как есть
SERVER_SECRET=cdb7247459d790969c9d59fd68299a2b90a0844c032c519ed418f4279bb16e43

# Не обязательно теперь, т.к. сайт и API на одном домене (server.js отдаёт всё сам).
# Нужно только если ещё какой-то сторонний сайт будет дёргать этот API.
ALLOWED_ORIGINS=
