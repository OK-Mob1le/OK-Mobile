# ==== OK-Mobile Бухгалтерия — переменные окружения ====
# Скопируйте в .env и заполните значениями.

# Токен Telegram-бота (получить у @BotFather). НИКОГДА не публикуйте.
BOT_TOKEN=

# Строка подключения к PostgreSQL (Railway добавляет автоматически).
# Если не задана — используется локальное JSON-хранилище (data.json).
DATABASE_URL=

# Секрет для подписи JWT. Сгенерируйте длинную случайную строку.
JWT_SECRET=change-me-to-a-long-random-secret

# URL фронтенда для CORS. "*" — разрешить всем (для разработки).
FRONTEND_URL=*

# Порт (Railway задаёт автоматически).
PORT=3000

# Только для разработки: возвращать код подтверждения в ответе API.
# В продакшене обязательно false.
DEV_RETURN_CODE=false